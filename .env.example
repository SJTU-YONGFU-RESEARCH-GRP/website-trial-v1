# Production API and frontend listener. Use a non-root service account.
NODE_ENV=production
HOST=::
PORT=3000

# Must be writable by the service account and outside this source checkout.
EDA_STORAGE_ROOT=/var/lib/website-trial-v1
EDA_DATABASE_PATH=/var/lib/website-trial-v1/platform.sqlite3

# Public origin used for Origin/CSRF validation. Do not include a path suffix.
EDA_PUBLIC_ORIGIN=https://eda.example.edu
EDA_COOKIE_SECURE=true
EDA_TRUST_PROXY=true
EDA_SESSION_TTL_SECONDS=43200

# Independent persistent queue limits.
EDA_BENCHMARK_CONCURRENCY=1
EDA_DIGITAL_CONCURRENCY=2
EDA_PPA_CONCURRENCY=1
EDA_MAX_SWEEP_JOBS=32
EDA_CANCEL_GRACE_SECONDS=10

# Upload/storage limits; per-user quotas may be lower.
EDA_MAX_UPLOAD_FILES=512
EDA_MAX_UPLOAD_FILE_BYTES=67108864
EDA_MAX_UPLOAD_TOTAL_BYTES=536870912
EDA_MAX_LOG_BYTES=134217728

# Development frontend proxy target. Production serves dist/ from the API host.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_BASE_PATH=/

# GitHub Pages sets this to true. It removes login/upload/Start actions.
VITE_READ_ONLY_DEMO=false
